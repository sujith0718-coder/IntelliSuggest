# ==============================================================================
# IntelliSuggest Environment Configuration Template (.env.example)
# Copy this file to .env and configure values for your environment.
# DO NOT commit real API keys or credentials to Git.
# ==============================================================================

# Server Network Configuration
PORT=10000

# Database Driver Selection: "sqlite" (local development) or "sqlitecloud" (production)
DATABASE_DRIVER=sqlite

# Local SQLite Driver Settings (used when DATABASE_DRIVER=sqlite)
DATABASE_PATH=intellisuggest.db
SAMPLE_DATA_PATH=database/sample_data.csv

# SQLiteCloud Remote Driver Settings (used when DATABASE_DRIVER=sqlitecloud)
# Format: sqlitecloud://<host>:8860/<database_name>?apikey=<your_api_key>
SQLITECLOUD_URL=sqlitecloud://<project_id>.<region>.sqlite.cloud:8860/intellisuggest.sqlite?apikey=<your_sqlitecloud_api_key>

# Optional Discrete SQLiteCloud Variables (alternative to SQLITECLOUD_URL)
# SQLITECLOUD_GATEWAY_URL=https://<project_id>.<region>.gateway.sqlite.cloud/v2/weblite/sql
# SQLITECLOUD_DATABASE=intellisuggest.sqlite
# SQLITECLOUD_API_KEY=your_api_key_here

# Cross-Origin Resource Sharing (CORS) Configuration
# Leave as * for universal access, or specify your frontend Vercel origin:
# CORS_ORIGIN=https://<your-project>.vercel.app
CORS_ORIGIN=*

# Administrative API Authentication Key
# Required for modifying APIs (POST/PUT/DELETE /api/keywords, cleanup, /api/concepts)
ADMIN_API_KEY=your_secure_admin_token_here

# Google Programmable Search Engine Integration (Optional downstream discovery)
# VITE_GOOGLE_CSE_CX=your_google_cse_id_here

